{
  "name": "satpredict-cf",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute satpredict --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute satpredict --remote --file=./migrations/0001_init.sql",
    "seed": "wrangler dev --test-scheduled",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "satellite.js": "5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0",
    "vitest": "^2.1.0"
  }
}
